[Unit]
Description=AglusNVR - Gravador de vídeo em rede
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aglus-nvr
Group=aglus-nvr
ExecStart=/usr/local/bin/aglus-nvr -config /var/lib/aglus-nvr/aglus-nvr.yaml
Restart=on-failure
RestartSec=5s
WorkingDirectory=/var/lib/aglus-nvr
LimitNOFILE=65536

# Reforço de segurança
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aglus-nvr
# Limite de memória — remova o comentário para Raspberry Pi 3B (905 MB de RAM)
# MemoryMax=512M

[Install]
WantedBy=multi-user.target
